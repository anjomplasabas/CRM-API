# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

APP_ENV=test
# SQLite file (not :memory:) so schema persists across connections and
# dama/doctrine-test-bundle can wrap tests in transactions.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

# JWT keys generated at test boot; see tests/bootstrap.php
JWT_SECRET_KEY='%kernel.project_dir%/var/jwt/test-private.pem'
JWT_PUBLIC_KEY='%kernel.project_dir%/var/jwt/test-public.pem'
JWT_PASSPHRASE='test-passphrase'

# Firebase bundle requires a credentials file to boot; we point at a dummy and
# alias the Database contract to an in-memory fake in services_test.yaml.
FIREBASE_CREDENTIALS='%kernel.project_dir%/tests/Fixtures/firebase-fake.json'

BASE_URL='https://graph.facebook.test'
